# DB
DB_URL=jdbc:postgresql://localhost:5432/hirekit
DB_USERNAME=hirekit
DB_PASSWORD=your_db_password

# Kakao OAuth
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=https://your-api-domain/login/oauth2/code/kakao

# App
API_URL=https://your-api-domain
FRONTEND_URL=https://your-frontend-domain
JWT_SECRET=your_jwt_secret_min_32_chars
COOKIE_DOMAIN=.your-domain

# Public Data API
PUBLIC_DATA_SERVICE_KEY=your_public_data_service_key

# Redis (토큰 리프레시 캐시 등)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=hirekit-dev
